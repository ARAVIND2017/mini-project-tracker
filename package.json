{
  "name": "mini-project-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/host-config.mjs dist --check-vercel && node scripts/scan-bundle.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash scripts/db-test.sh",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:db && pnpm build",
    "stack:start": "bash scripts/local-stack/start.sh",
    "stack:stop": "bash scripts/local-stack/stop.sh",
    "test:e2e": "LOCAL_ANON_KEY=$(cat .local-stack/anon.jwt) playwright test",
    "test:e2e:prod": "VITE_SUPABASE_URL=http://localhost:54321 VITE_SUPABASE_PUBLISHABLE_KEY=$(cat .local-stack/anon.jwt) CSP_EXTRA_CONNECT='http://localhost:54321 ws://localhost:54321' pnpm build && (node scripts/serve-dist.mjs 4173 & sleep 1; LOCAL_ANON_KEY=$(cat .local-stack/anon.jwt) PW_BASE_URL=http://localhost:4173 playwright test; s=$?; pkill -f serve-dist.mjs; exit $s)"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.6",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
